# Copy to `.env` locally. Never commit real values.
# See docs/backend-api.md and docs/privacy-model.md.

# --- Provider (OpenAI-compatible client) ---------------------------------------
# The backend uses the `openai` SDK against any OpenAI-compatible endpoint.
# Swap base_url + model to point at Groq / OpenAI / DeepSeek / Together /
# vLLM / LM Studio / Ollama without any code changes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_TRANSCRIBE_MODEL=whisper-large-v3
OPENAI_CHAT_MODEL=llama-3.1-70b-versatile

# --- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Auth (M2: shared secret; M4+: per-install tokens) -------------------------
SHOBDO_SHARED_SECRET=

# --- Limits --------------------------------------------------------------------
MAX_AUDIO_BYTES=2097152         # 2 MB
MAX_AUDIO_SECONDS=60
MAX_TEXT_CHARS=4000
MAX_HINTS=20
RATE_LIMIT_PER_MINUTE=60

# --- Timeouts (ms) -------------------------------------------------------------
PROVIDER_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=20000
