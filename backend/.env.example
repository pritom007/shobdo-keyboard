# Copy to `.env` locally. Never commit real values.
# See docs/privacy-model.md and docs/security-threat-model.md.

# --- Provider (OpenAI-compatible client) ---------------------------------------
# The backend uses the `openai` SDK against any OpenAI-compatible endpoint.
# Swap base_url + model to point at Groq / OpenAI / DeepSeek / Together /
# vLLM / LM Studio / Ollama without any code changes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_TRANSCRIBE_MODEL=whisper-large-v3

# --- Server --------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- CORS ----------------------------------------------------------------------
# Native Android clients do not need CORS. For a web UI, list exact HTTPS origins.
ALLOWED_ORIGINS=

# --- Limits --------------------------------------------------------------------
MAX_AUDIO_BYTES=2097152         # 2 MB
MAX_AUDIO_SECONDS=60
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_MAX_CLIENTS=10000

# --- Timeouts ------------------------------------------------------------------
PROVIDER_TIMEOUT_MS=20000
