<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Mic for voice-to-text. Requested at runtime; never required to use the
         keyboard itself, only the Voice screen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed to record audio on Android 6+; declared so the OS treats the app
         as a voice-capable app. Still guarded by RECORD_AUDIO at runtime. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shohojakkhor"
        tools:targetApi="34">

        <activity
            android:name=".setup.SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Shohojakkhor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".voice.VoiceActivity"
            android:exported="false"
            android:label="@string/voice_title"
            android:theme="@style/Theme.Shohojakkhor" />

    </application>

</manifest>
