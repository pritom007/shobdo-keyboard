<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config.

  Android (API 28+) blocks cleartext HTTP by default. The Shobdo backend is
  reached over HTTPS in production, but for LOCAL DEVELOPMENT the Android
  client talks to the dev machine's localhost via:

    - `adb reverse tcp:8000 tcp:8000` on a physical device  → 127.0.0.1:8000
    - the Android emulator                            → 10.0.2.2:8000

  Both of those are cleartext `http://`. This config permits cleartext ONLY
  for those loopback dev addresses, so the production HTTPS backend is never
  weakened and the app's general cleartext block stays in place.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
